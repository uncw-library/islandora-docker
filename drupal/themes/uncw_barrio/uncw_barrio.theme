<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\uncw_barrio\Hook\BootstrapBarrioSubthemeHooks;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
#[LegacyHook]
function uncw_barrio_form_system_theme_settings_alter(&$form, FormStateInterface $form_state)
{
    \Drupal::service(BootstrapBarrioSubthemeHooks::class)->formSystemThemeSettingsAlter($form, $form_state);
}

/**
 * Implements hook_preprocess_page().
 *
 * Adds an "Edit" button to the full-page view of a node (e.g.
 * /islandora/title-3) for users who may edit it, linking to the node's edit
 * form (e.g. /node/104/edit), like the Edit button in /admin/content.
 */
function uncw_barrio_preprocess_page(array &$variables): void {
  $variables['node_edit_button'] = [];

  // Only on the node's canonical page, not on its edit/revisions/etc. routes.
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.node.canonical') {
    return;
  }
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  // Only for logged-in users who are permitted to edit this node.
  $access = $node->access('update', NULL, TRUE);
  $build = [];
  if (\Drupal::currentUser()->isAuthenticated() && $access->isAllowed()) {
    $build = [
      '#type' => 'link',
      '#title' => t('Edit'),
      '#url' => \Drupal\Core\Url::fromRoute('entity.node.edit_form', ['node' => $node->id()]),
      '#attributes' => ['class' => ['btn', 'btn-primary', 'uncw-edit-button__link']],
    ];
  }
  // Vary by who is viewing and by this route, whether or not the button shows.
  \Drupal\Core\Cache\CacheableMetadata::createFromObject($access)
    ->addCacheContexts(['route', 'user.roles:authenticated', 'user.permissions'])
    ->applyTo($build);
  $variables['node_edit_button'] = $build;
}
