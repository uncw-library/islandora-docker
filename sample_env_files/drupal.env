
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=MATCH_2  

DRUSH_OPTIONS_URI=https://islandora.dev   # used by drupal/rootfs/etc/s6-overlay/scripts/install.sh

DRUPAL_DEFAULT_ACCOUNT_PASSWORD=CHANGEME
DRUPAL_DEFAULT_CANTALOUPE_URL=https://islandora.dev/cantaloupe/iiif/2
DRUPAL_DEFAULT_DB_NAME=islandora_drupal
DRUPAL_DEFAULT_DB_USER=islandora_drupal
DRUPAL_DEFAULT_DB_PASSWORD=MATCH_3

DRUPAL_DEFAULT_FCREPO_HOST=fcrepo
DRUPAL_DEFAULT_FCREPO_PORT=8080
DRUPAL_DEFAULT_FCREPO_URL=http://fcrepo:8080/fcrepo/rest/

DRUPAL_DEFAULT_INSTALL_EXISTING_CONFIG=true
DRUPAL_DEFAULT_NAME=Islandora Digital Collections
DRUPAL_DEFAULT_PROFILE=minimal
DRUPAL_DEFAULT_SALT=CHANGEME
DRUPAL_DEFAULT_SITE_URL=islandora.dev
DRUPAL_DEFAULT_SOLR_CORE=default

DRUPAL_DEFAULT_BROKER_URL=tcp://activemq:61613

# This list should be all the IPs in front of your Drupal docker container
# this is used to pass the original client IP to the drupal container so
# drupal/php is aware of who sent the original request
# if you're not behind a reverse proxy, you probably do not need to edit these IPs
# if you are behind a reverse proxy, most likely you can just replace FRONTEND_IP_1
# with the IP address used on your front end // reverse proxy domain
# NGINX_SET_REAL_IP_FROM: 127.0.0.1/32
# NGINX_SET_REAL_IP_FROM2: 172.0.0.0/8
# NGINX_SET_REAL_IP_FROM3: 192.168.0.0/16
