# from https://github.com/Islandora-Devops/isle-buildkit/blob/main/mariadb/Dockerfile

MYSQL_ROOT_PASSWORD=MATCH_2
MYSQL_DATABASE=islandora_drupal
MYSQL_USER=islandora_drupal
MYSQL_PASSWORD=MATCH_3
MYSQL_MAX_ALLOWED_PACKET=16777216
MYSQL_TRANSACTION_ISOLATION=READ-COMMITTED

S6_CMD_WAIT_FOR_SERVICES_MAXTIME=600000

MARIADB_AUTO_UPGRADE=1

# MYSQL_ROOT_USER=${DB_ROOT_USER:-root}
